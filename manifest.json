{
  "manifest_version": 3,
  "name": "ExamPilot - 智能解题引擎",
  "version": "1.7.2",
  "description": "基于视觉AI的智能解题系统：一键截图识别网页题目，大模型实时推理，精准获取答案与解析",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ExamPilot - 智能解题引擎"
  },
  "commands": {
    "capture-fullscreen": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "MacCtrl+Shift+1"
      },
      "description": "全屏截图并识别"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "MacCtrl+Shift+2"
      },
      "description": "选择区域并识别"
    },
    "switch-config": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "MacCtrl+Shift+3"
      },
      "description": "切换到下一个 AI 配置"
    },
    "clear-results": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "MacCtrl+Shift+4"
      },
      "description": "取消当前识别或清除识别结果"
    }
  },
  "optional_host_permissions": ["https://*/*"],
  "web_accessible_resources": [{
    "resources": ["permission/*"],
    "matches": ["<all_urls>"]
  }],
  "background": {
    "service_worker": "background/index.js"
  }
}
