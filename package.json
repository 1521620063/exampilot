{
  "name": "exampilot",
  "private": true,
  "version": "1.7.5",
  "scripts": {
    "build": "npm run chrome:build && npm run desktop:build",
    "test": "npm run chrome:test && npm run desktop:test",
    "chrome:build": "node chrome-extension/scripts/build.mjs",
    "chrome:build:package": "cross-env NO_MINIFY=true node chrome-extension/scripts/build.mjs",
    "chrome:build:full": "cross-env BUILD_MODE=full node chrome-extension/scripts/build.mjs",
    "chrome:build:full:package": "cross-env BUILD_MODE=full NO_MINIFY=true node chrome-extension/scripts/build.mjs",
    "chrome:test": "node --test chrome-extension/background/*.test.js",
    "desktop:dev": "vite --config desktop-app/vite.config.mjs",
    "desktop:build": "vite build --config desktop-app/vite.config.mjs",
    "desktop:test": "node --test desktop-app/test/*.test.mjs",
    "tauri:dev": "tauri dev --config desktop-app/src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config desktop-app/src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "htm": "^3.1.1",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.0",
    "vite": "^7.3.0"
  }
}
