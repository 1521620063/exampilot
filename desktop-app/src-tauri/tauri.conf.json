{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExamPilot",
  "version": "1.8.0",
  "identifier": "com.exampilot.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "npm run desktop:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "answer",
        "title": "ExamPilot",
        "url": "index.html",
        "width": 360,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "backgroundThrottling": "disabled",
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MDYwOEI1RkUwNUUwQjcKUldTMzRBWCt0UWdHbVZXbnFOYmdsV0lpcjNRZ1ZNNnUzZElrOXorRlNzOGVCYmdBRHhzSG1OWUIK",
      "endpoints": [
        "https://github.com/1521620063/exampilot/releases/latest/download/latest.json"
      ]
    }
  }
}
